# ── MySQL ──
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=long_horizon_agent

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── LLM ──
# 任意 OpenAI 兼容接口均可用(OpenAI / DeepSeek / OpenRouter 等),改这三项即可切换。
# 示例 A:OpenRouter 免费模型 nvidia/nemotron-3.5-lightning:free
OPENAI_API_KEY=sk-or-v1-xxx
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
# 示例 B:DeepSeek
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ── Search ──
# 搜索后端:auto=tavily(有 key)→bing→ddg;也可显式 tavily / bing / ddg
SEARCH_PROVIDER=auto
TAVILY_API_KEY=

# ── Evaluator (三阶段评估门) ──
# phase 3 打分用弱模型;留空回落主模型档
EVALUATOR_SCORE_MODEL=
EVALUATOR_SCORE_API_KEY=
EVALUATOR_SCORE_BASE_URL=
FORWARD_RELEVANCE_THRESHOLD=0.4
REVERSE_MAX_TOOL_CALLS=5
MAX_DEFENSE_ROUNDS=1
SCORE_PASS_THRESHOLD=0.7
HEAVY_CRITERIA_WEIGHT=0.3
MAX_EVAL_LLM_CALLS_PER_TASK=100
MAX_STAGE_RETRIES=3

# ── Checkpointer ──
# 图状态(checkpoint)后端:mysql=持久化到 MySQL,worker 重启后可恢复;memory=进程内
CHECKPOINT_BACKEND=mysql

# ── Worker ──
WORKER_ID=worker-1
WORKER_POLL_INTERVAL_SECONDS=5

# ── Budget Defaults ──
DEFAULT_MAX_TOKENS=200000
DEFAULT_MAX_SECONDS=1800
DEFAULT_MAX_TOOL_CALLS=50
DEFAULT_MAX_COST=5.0

# ── API ──
API_HOST=0.0.0.0
API_PORT=8000
